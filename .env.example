# Copy this file to .env. Never commit real credentials.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=openai:gpt-4.1-mini

# Anthropic (Pydantic AI provider-qualified model name)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=anthropic:claude-sonnet-4-5

#VLLM credentials
VLLM_ENDPOINT=https://localhost:8000/v1/chat/completions
VLLM_MODEL=NousResearch/Hermes-3-Llama-3.1-8B
VLLM_API_KEY=

#LITELLM credentials
LITELLM_ENDPOINT=https://inference-api.nousresearch.com/v1/chat/completions
LITELLM_API_KEY=
LITELLM_MODEL=Hermes-4-405B
LITELLM_TEMPERATURE=0.7
LITELLM_MAX_TOKENS=4096

# Database Credentials
DB_NAME=gymkhana
DB_USER=db_user
DB_PASSWORD=db_pwd@123
DB_HOST=localhost
DB_PORT=5433
